{
  "functions": {
    "api/send-email.js": {
      "maxDuration": 30
    },
    "api/send-feedback.js": {
      "maxDuration": 30
    },
    "api/auth/oauth-login.js": {
      "maxDuration": 10
    },
    "api/auth/oauth-callback.js": {
      "maxDuration": 30
    },
    "api/auth/oauth-logout.js": {
      "maxDuration": 10
    },
    "api/auth/oauth-verify.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
